{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@artisan237/ui": ["./packages/ui/src"],
      "@artisan237/types": ["./packages/types/src"],
      "@artisan237/config": ["./packages/config/src"],
      "@artisan237/shared": ["./packages/shared/src"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "apps/*/app"],
  "exclude": ["node_modules", "dist"]
}