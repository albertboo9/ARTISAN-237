{
  "name": "@artisan237/config",
  "version": "1.0.0",
  "description": "Shared configuration utilities",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm 2>/dev/null || true",
    "typecheck": "tsc --noEmit || true",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@artisan237/types": "workspace:*",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "tsup": "8.3.0",
    "typescript": "5.6.2"
  }
}