// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USERS, ROLES & AUDIT
// ==========================================

model User {
  id           String     @id @default(uuid())
  phoneNumber  String     @unique
  email        String?    @unique
  passwordHash String?
  firstName    String
  lastName     String
  avatarUrl                 String?
  role                      Role       @default(CLIENT)
  status                    UserStatus @default(ACTIVE)
  emailVerified             Boolean    @default(false)
  emailVerificationCode     String?
  passwordResetToken        String?
  passwordResetExpires      DateTime?

  artisanProfile   ArtisanProfile?
  clientJobs       Job[]             @relation("ClientJobs")
  reviewsGiven     Review[]          @relation("ReviewAuthor")
  reviewsReceived  Review[]          @relation("ReviewTarget")
  messagesSent     Message[]
  kycVerifications KycVerification[]
  notifications    Notification[]
  disputesRaised   Dispute[]         @relation("DisputeRaiser")
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  CLIENT
  ARTISAN
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // Connexion, Paiement, Litige, etc.
  details   Json?
  createdAt DateTime @default(now())
}

// ==========================================
// 2. ARTISAN PROFILE & KYC
// ==========================================

model ArtisanProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  bio             String?
  experienceYears Int     @default(0)
  isAvailable     Boolean @default(true)

  rating       Float @default(0.0)
  totalJobs    Int   @default(0)
  cancelRate   Float @default(0.0)
  responseRate Float @default(1.0)

  lastLat           Float?
  lastLng           Float?
  locationUpdatedAt DateTime?

  skills ArtisanSkill[]
  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KycVerification {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  provider        String    @default("DIDIT")
  externalId      String
  status          KycStatus
  verificationUrl String?
  verifiedAt      DateTime?
  rawResponse     Json?

  createdAt DateTime @default(now())
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// ==========================================
// 3. TAXONOMIE (MÉTIERS) & SERVICES
// ==========================================

model Category {
  id       String     @id @default(uuid())
  parentId String? // Hierarchy: Bâtiment -> Plomberie
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  name     String
  slug     String     @unique
  iconUrl  String?
  services Service[]
}

model Service {
  id         String         @id @default(uuid())
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id])
  name       String
  basePrice  Decimal?
  jobs       Job[]
  skills     ArtisanSkill[]
}

model ArtisanSkill {
  artisanId String
  serviceId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id])
  service   Service        @relation(fields: [serviceId], references: [id])

  @@id([artisanId, serviceId])
}

// ==========================================
// 4. JOBS, MEDIA, QUOTES & REVIEWS
// ==========================================

model Job {
  id        String  @id @default(uuid())
  clientId  String
  client    User    @relation("ClientJobs", fields: [clientId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  description String
  lat         Float
  lng         Float
  address     String?

  status       JobStatus @default(SEARCHING)
  scheduledFor DateTime?

  media    JobMedia[]
  quotes   Quote[]
  chatRoom ChatRoom?
  escrow   EscrowAccount?
  disputes Dispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobMedia {
  id    String    @id @default(uuid())
  jobId String
  job   Job       @relation(fields: [jobId], references: [id])
  url   String
  type  MediaType
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum JobStatus {
  SEARCHING
  QUOTE_ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model Quote {
  id        String         @id @default(uuid())
  jobId     String
  job       Job            @relation(fields: [jobId], references: [id])
  artisanId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id])

  estimatedPrice Decimal
  materialsPrice Decimal?
  laborPrice     Decimal
  description    String

  status  QuoteStatus @default(PENDING)
  invoice Invoice?

  createdAt DateTime @default(now())
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Review {
  id       String @id @default(uuid())
  jobId    String
  authorId String
  targetId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
}

// ==========================================
// 5. FINANCIAL LAYER (Stripe, Escrow, Invoice)
// ==========================================

model EscrowAccount {
  id         String       @id @default(uuid())
  jobId      String       @unique
  job        Job          @relation(fields: [jobId], references: [id])
  amount     Decimal
  status     EscrowStatus
  stripePi   String? // Stripe Payment Intent ID
  fundedAt   DateTime?
  releasedAt DateTime?
}

enum EscrowStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

model Invoice {
  id      String @id @default(uuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id])

  invoiceNumber String  @unique
  subtotal      Decimal
  taxAmount     Decimal
  platformFee   Decimal
  totalAmount   Decimal

  items  InvoiceItem[]
  pdfUrl String?
  status InvoiceStatus

  createdAt DateTime @default(now())
}

model InvoiceItem {
  id        String          @id @default(uuid())
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])
  name      String
  amount    Decimal
  type      InvoiceItemType
}

enum InvoiceItemType {
  LABOR
  MATERIAL
  TRAVEL
  FEE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

// ==========================================
// 6. DISPUTE & COMPLIANCE
// ==========================================

model Dispute {
  id         String        @id @default(uuid())
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id])
  raisedById String
  raisedBy   User          @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason     String
  status     DisputeStatus
  resolution String?
  createdAt  DateTime      @default(now())
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

// ==========================================
// 7. REALTIME, MESSAGING & NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String // SYSTEM, JOB_MATCH, QUOTE, ESCROW, DISPUTE
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatRoom {
  id        String    @id @default(uuid())
  jobId     String    @unique
  job       Job       @relation(fields: [jobId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id         String   @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  content    String
  mediaUrl   String?
  createdAt  DateTime @default(now())
}
