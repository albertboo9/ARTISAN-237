# .env.example — Artisan237 Full-Stack Application
# Copy to .env.local and fill in real values
#
# ⚠️  NEVER commit .env or .env.local to version control.
# ⚠️  Use different secrets for dev / staging / production.

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development             # development | test | production
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
PORT=3001

# ─── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://postgres:your-secure-password@localhost:5432/artisan237?schema=public"
DB_ROOT_PASSWORD=your-root-password
DB_PASSWORD=your-app-password

# ─── Redis (Cache & Rate Limiting) ─────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication ────────────────────────────────────────────
JWT_SECRET="generate-a-32-char-or-more-random-secret-key-here!!"
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_SECRET="another-32-char-secret-for-refresh-tokens!!"

# ─── Email / SMTP (optional — for email verification, resets) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Artisan237 <noreply@artisan237.com>

# ─── File Storage (S3 / MinIO) ─────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artisan237-assets
S3_REGION=us-east-1

# ─── ML / Recommendation Service ───────────────────────────────
AI_SERVICE_URL="http://localhost:8000"

# ─── Stripe (Escrow) ───────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── KYC (Didit) ───────────────────────────────────────────────
DIDIT_CLIENT_ID="your_didit_client_id"
DIDIT_CLIENT_SECRET="your_didit_client_secret"
DIDIT_API_URL="https://api.didit.me/v1"

# ─── Notifications (Firebase Admin) ────────────────────────────
FIREBASE_PROJECT_ID="your-firebase-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW=900000    # 15 minutes in ms
RATE_LIMIT_MAX=100          # max requests per window

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000